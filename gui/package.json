{
  "name": "corpusqa-gui",
  "version": "0.1.2",
  "private": true,
  "description": "Desktop GUI for corpusqa",
  "author": "Stephen Genusa",
  "license": "MIT",
  "homepage": "https://github.com/StephenGenusa/corpusqa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.corpusqa.gui",
    "productName": "corpusqa",
    "directories": {
      "buildResources": "assets"
    },
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "smoke.js",
      "src/**",
      "renderer/**",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist/corpusqa-backend",
        "to": "backend"
      },
      {
        "from": "../corpusqa.example.yaml",
        "to": "corpusqa.example.yaml"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Stephen Genusa",
      "artifactName": "corpusqa-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "corpusqa-${version}-macos-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "corpusqa-${version}-windows-${arch}-setup.${ext}"
    }
  }
}
